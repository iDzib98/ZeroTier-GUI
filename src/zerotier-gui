    def get_service_status(self):
        data = check_output(
            ["systemctl", "show", "zerotier-one"], universal_newlines=True
        ).split("\n")
        formatted_data = {}
        for entry in data:
            key_value = entry.split("=", 1)
            if len(key_value) == 2:
                formatted_data[key_value[0]] = key_value[1]

        return formatted_data["ActiveState"]

