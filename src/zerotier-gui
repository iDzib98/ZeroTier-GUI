def host_command_environment():
    """Keep PyInstaller's bundled libraries away from host system tools."""
    environment = environ.copy()
    if getattr(sys, "frozen", False):
        original_library_path = environment.pop("LD_LIBRARY_PATH_ORIG", None)
        if original_library_path:
            environment["LD_LIBRARY_PATH"] = original_library_path
        else:
            environment.pop("LD_LIBRARY_PATH", None)
    return environment


def check_output(*args, **kwargs):
    if getattr(sys, "frozen", False):
        kwargs["env"] = host_command_environment()
    return subprocess_check_output(*args, **kwargs)


def system(command):
    if getattr(sys, "frozen", False):
        return subprocess_run(
            command,
            shell=True,
            env=host_command_environment(),
        ).returncode
    return os_system(command)

