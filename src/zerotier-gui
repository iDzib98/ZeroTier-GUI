    def status_badge_style(self, status):
        normalized = status.upper().replace(" ", "_")
        if normalized in ("OK", "OKAY"):
            return "Okay", COLORS["success_soft"], COLORS["success"], "✓"
        if "REQUESTING" in normalized or "AUTHORIZ" in normalized:
            return "Authorizing", COLORS["accent_soft"], COLORS["accent"], "…"
        if normalized == "INTERFACE_DOWN":
            return "Interface down", COLORS["danger_soft"], COLORS["danger"], "!"
        if "ACCESS_DENIED" in normalized or "NOT_FOUND" in normalized:
            return "Denied", COLORS["danger_soft"], COLORS["danger"], "!"
        return (
            status.replace("_", " ").title(),
            COLORS["surface_alt"],
            COLORS["muted"],
            "•",
        )

    def position_status_badges(self):
        if not hasattr(self, "status_badges") or not self.networkList.winfo_exists():
            return
        for item, badge in tuple(getattr(self, "status_badge_widgets", {}).items()):
            if item not in self.status_badges:
                badge.destroy()
                del self.status_badge_widgets[item]

        if not hasattr(self, "status_badge_widgets"):
            self.status_badge_widgets = {}
        selected = set(self.networkList.selection())
        for item, status in self.status_badges.items():
            cell = self.networkList.bbox(item, "Status")
            badge = self.status_badge_widgets.get(item)
            if not cell:
                if badge:
                    badge.place_forget()
                continue

            label, fill, foreground, symbol = self.status_badge_style(status)
            text_font = ("TkDefaultFont", 9, "bold")
            measure = tkfont.Font(root=self.window, font=text_font)
            width = measure.measure(label) + 39
            height = 26
            row_background = (
                COLORS["selection"]
                if item in selected
                else COLORS["row_alt"]
                if "even" in self.networkList.item(item, "tags")
                else COLORS["surface"]
            )
            if not badge:
                badge = tk.Canvas(
                    self.networkList,
                    width=width,
                    height=height,
                    bg=row_background,
                    highlightthickness=0,
                    bd=0,
                    cursor="hand2",
                )
                badge.bind(
                    "<Button-1>",
                    lambda _event, row=item: self.select_network_row(row),
                )
                self.status_badge_widgets[item] = badge

            badge.configure(width=width, height=height, bg=row_background)
            badge.delete("all")
            badge.create_polygon(
                rounded_rectangle_points(1, 1, width - 1, height - 1, 13),
                fill=fill,
                outline="",
            )
            badge.create_oval(7, 7, 19, 19, fill=foreground, outline="")
            badge.create_text(
                13,
                13,
                text=symbol,
                fill=fill,
                font=("TkDefaultFont", 7, "bold"),
            )
            badge.create_text(
                25,
                13,
                text=label,
                anchor="w",
                fill=foreground,
                font=text_font,
            )
            x, y, cell_width, cell_height = cell
            badge.place(
                x=x + max(0, (cell_width - width) // 2),
                y=y + (cell_height - height) // 2,
            )

