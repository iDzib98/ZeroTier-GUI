    def create_rounded_card(self, parent, width=400, height=120, radius=15):
        canvas = tk.Canvas(
            parent,
            width=width,
            height=height,
            bg=parent.cget("bg"),
            highlightthickness=0,
            bd=0,
        )
        surface = tk.Frame(canvas, bg=COLORS["surface"])
        shape = canvas.create_polygon(
            rounded_rectangle_points(1, 1, width - 1, height - 1, radius),
            fill=COLORS["surface"],
            outline=COLORS["border"],
            width=1,
        )
        content = canvas.create_window(
            radius,
            radius,
            anchor="nw",
            window=surface,
            width=width - 2 * radius,
            height=height - 2 * radius,
        )

        def resize(event):
            card_radius = min(radius, event.width / 2, event.height / 2)
            canvas.coords(
                shape,
                *rounded_rectangle_points(
                    1,
                    1,
                    event.width - 1,
                    event.height - 1,
                    card_radius,
                ),
            )
            canvas.itemconfigure(
                content,
                width=max(1, event.width - 2 * card_radius),
                height=max(1, event.height - 2 * card_radius),
            )

        canvas.bind("<Configure>", resize)
        return canvas, surface

    def update_responsive_layout(self, _event=None):
        width = self.window.winfo_width()
        height = self.window.winfo_height()
        compact = width < 920
        short = height < 650

        self.page.configure(
            padx=18 if compact else 30,
            pady=14 if short else 26,
        )
        self.header.pack_configure(pady=(0, 12 if short else 22))
        self.toolbar.pack_configure(pady=(0, 8 if short else 16))
        self.footer.pack_configure(pady=(8 if short else 14, 0))
        self.footer.configure(height=108 if compact else 86)
        self.networkCard.configure(height=220 if short else 340)
        self.networkList.configure(height=3 if short else 12)

        if width < 900:
            self.toolbar_right.grid_configure(
                row=1, column=0, columnspan=2, sticky="e", pady=(9, 0)
            )
        else:
            self.toolbar_right.grid_configure(
                row=0, column=1, columnspan=1, sticky="e", pady=0
            )

        if width < 920:
            self.selectionLabel.grid_configure(
                row=0, column=0, columnspan=2, sticky="w"
            )
            self.footer_actions.grid_configure(
                row=1, column=0, columnspan=2, sticky="e", pady=(9, 0)
            )
        else:
            self.selectionLabel.grid_configure(
                row=0, column=0, columnspan=1, sticky="w"
