def detect_system_theme():
    """Detect the desktop's preferred color scheme without extra dependencies."""
    gtk_theme = environ.get("GTK_THEME", "").lower()
    if "dark" in gtk_theme:
        return "dark"

    def desktop_command(command):
        if environ.get("FLATPAK_ID"):
            command = ["flatpak-spawn", "--host"] + command
        return check_output(
            command,
            stderr=STDOUT,
            timeout=2,
            universal_newlines=True,
        ).strip().strip("'\"").lower()

    # Deepin 23/25 uses its own schemas for the active theme rather than
    # org.gnome.desktop.interface.
    for schema, key in (
        ("com.deepin.dde.appearance", "gtk-theme"),
        ("com.deepin.xsettings", "theme-name"),
    ):
        try:
            value = desktop_command(["gsettings", "get", schema, key])
            if value:
                return "dark" if "dark" in value else "light"
        except (OSError, CalledProcessError, TimeoutExpired):
            pass

    # KDE Plasma stores the selected scheme in kdeglobals.
    if environ.get("FLATPAK_ID"):
        for reader in ("kreadconfig6", "kreadconfig5"):
            try:
                value = desktop_command(
                    [reader, "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme"]
                )
                if value:
                    return "dark" if "dark" in value else "light"
            except (OSError, CalledProcessError, TimeoutExpired):
                pass
    else:
        kdeglobals = path.expanduser("~/.config/kdeglobals")
        try:
            with open(kdeglobals, "r", encoding="utf-8") as settings:
                in_general = False
                for line in settings:
                    line = line.strip()
                    if line.startswith("["):
                        in_general = line.lower() == "[general]"
                    elif in_general and line.lower().startswith("colorscheme="):
                        if "dark" in line.split("=", 1)[1].lower():
                            return "dark"
                        return "light"
        except OSError:
            pass

    # GNOME, Cinnamon, and GTK-based desktops expose this preference through
    # gsettings. Older desktops may only provide a theme name.
    for key in ("color-scheme", "gtk-theme"):
        try:
            value = desktop_command(
                ["gsettings", "get", "org.gnome.desktop.interface", key]
            )
            if "dark" in value or value == "prefer-dark":
                return "dark"
            if key == "color-scheme" and value in ("prefer-light", "default"):
                continue
            if key == "gtk-theme" and value:
                return "light"
        except (OSError, CalledProcessError, TimeoutExpired):
            pass

    # Some lightweight desktops export COLORFGBG (terminal-style convention).
    color_fgbg = environ.get("COLORFGBG", "").rsplit(";", 1)[-1]
    if color_fgbg.isdigit() and int(color_fgbg) < 7:
        return "dark"
    return "light"


