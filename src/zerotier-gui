def rounded_rectangle_points(x1, y1, x2, y2, radius, steps=6):
    radius = max(0, min(radius, (x2 - x1) / 2, (y2 - y1) / 2))
    points = []
    corners = (
        (x2 - radius, y1 + radius, -90, 0),
        (x2 - radius, y2 - radius, 0, 90),
        (x1 + radius, y2 - radius, 90, 180),
        (x1 + radius, y1 + radius, 180, 270),
    )
    for center_x, center_y, start, end in corners:
        for step in range(steps + 1):
            angle = math.radians(start + (end - start) * step / steps)
            points.extend(
                (
                    center_x + radius * math.cos(angle),
                    center_y + radius * math.sin(angle),
                )
            )
    return points


class RoundedButton(tk.Canvas):
    """A small Canvas button so controls keep rounded corners in Tk themes."""

    def __init__(
        self,
        master,
        text,
        command,
        bg,
        fg,
        hover_bg,
        font=None,
        padx=14,
        pady=8,
        radius=9,
    ):
        self.text = text
        self.command = command
        self.fill = bg
        self.hover_fill = hover_bg
        self.text_color = fg
        self.radius = radius
        self.button_font = tkfont.Font(
            root=master,
            font=font or ("TkDefaultFont", 9, "bold"),
        )
        width = self.button_font.measure(text) + padx * 2
        height = self.button_font.metrics("linespace") + pady * 2
        self.padding_x = padx
        self.padding_y = pady
        super().__init__(
            master,
            width=width,
            height=height,
            bg=master.cget("bg"),
            highlightthickness=0,
            bd=0,
            takefocus=True,
            cursor="hand2",
        )
        self.shape = self.create_polygon(
            rounded_rectangle_points(1, 1, width - 1, height - 1, radius),
            fill=self.fill,
            outline="",
        )
        self.label = self.create_text(
            width / 2,
            height / 2,
            text=text,
            fill=self.text_color,
            font=self.button_font,
        )
        self.bind("<Enter>", lambda _event: self._set_fill(self.hover_fill))
        self.bind("<Leave>", lambda _event: self._set_fill(self.fill))
        self.bind("<Button-1>", self._click)
        self.bind("<Return>", self._click)
        self.bind("<space>", self._click)
        self.bind("<Configure>", self._resize)

    def _set_fill(self, color):
        self.itemconfigure(self.shape, fill=color)

    def _resize(self, event):
        self.coords(
            self.shape,
            *rounded_rectangle_points(
                1, 1, event.width - 1, event.height - 1, self.radius
            ),
        )
        self.coords(self.label, event.width / 2, event.height / 2)

    def _click(self, _event=None):
        if self.command:
            return self.command()

    def invoke(self):
        return self._click()


class RoundedPill(tk.Canvas):
    def __init__(self, master, text, fill, foreground, font=None):
        self.text = text
        self.fill = fill
        self.foreground = foreground
        self.pill_font = tkfont.Font(
            root=master,
            font=font or ("TkDefaultFont", 9, "bold"),
        )
        self.padding_x = 11
        self.height = self.pill_font.metrics("linespace") + 12
        width = self.pill_font.measure(text) + self.padding_x * 2
        super().__init__(
            master,
            width=width,
            height=self.height,
            bg=master.cget("bg"),
            highlightthickness=0,
            bd=0,
        )
        self._draw(width)

    def _draw(self, width):
        self.delete("all")
        self.configure(width=width)
        self.create_polygon(
            rounded_rectangle_points(1, 1, width - 1, self.height - 1, self.height / 2),
            fill=self.fill,
            outline="",
        )
        self.create_text(
            width / 2,
            self.height / 2,
            text=self.text,
            fill=self.foreground,
            font=self.pill_font,
        )

    def set_text(self, text):
        self.text = text
        width = self.pill_font.measure(text) + self.padding_x * 2
        self._draw(width)

