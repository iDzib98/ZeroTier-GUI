#!/bin/sh
# AppRun entrypoint for the ZeroTier-GUI AppImage.

HERE="$(dirname "$(readlink -f "${0}")")"

# Make the bundled binary discoverable.
export PATH="${HERE}/usr/bin:${PATH}"

# Some distributions (Debian/Deepin) place zerotier-cli in /usr/sbin.
export PATH="/usr/sbin:/sbin:${PATH}"

exec "${HERE}/usr/bin/zerotier-gui" "$@"
